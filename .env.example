# Duckway environment variables
# Copy to .dev.env (development) or .prod.env (production)
# Never commit env files to git — only .env.example is tracked.
#
# Dev:  cp .env.example .dev.env
# Prod: cp -n .env.example .prod.env && chmod 600 .prod.env

# Tailscale auth key (from https://login.tailscale.com/admin/settings/keys).
# For headscale, prefer separate short-lived tagged pre-auth keys for admin
# and gateway. TS_AUTHKEY remains a backward-compatible fallback.
TS_AUTHKEY=tskey-auth-xxxxx
TS_AUTHKEY_ADMIN=
TS_AUTHKEY_GATEWAY=
TS_AUTHKEY_SERVER=

# Tailscale hostname for this node
TS_HOSTNAME=duckway

# Extra args passed to `tailscale up`. Use for custom control servers
# (e.g. headscale): TS_EXTRA_ARGS=--login-server=https://headscale.example.com
TS_EXTRA_ARGS=

# Production profiles use unprivileged userspace networking and Tailscale
# Serve HTTP. No host port, /dev/net/tun, or added Linux capability is needed.

# Discord bot (optional, for notifications)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Production mode: split (recommended) or combined
DUCKWAY_PROD_MODE=split
