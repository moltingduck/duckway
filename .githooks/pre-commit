#!/bin/sh
# Pre-commit quality gate. Install once with:
#   git config core.hooksPath .githooks
# (already set in this repo; copy to .git/hooks/pre-commit on fresh clones)

set -e

# ── 1. Tests (with race detector when CGO is available) ────────────────────
if CGO_ENABLED=1 go build -race . > /dev/null 2>&1; then
  echo "[pre-commit] go test -race ./..."
  CGO_ENABLED=1 go test -race ./...
else
  echo "[pre-commit] go test ./...  (CGO unavailable — skipping race detector)"
  go test ./...
fi

# ── 2. Linting ─────────────────────────────────────────────────────────────
# golangci-lint must be on PATH. Install:
#   go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest
if command -v golangci-lint > /dev/null 2>&1; then
  echo "[pre-commit] golangci-lint run ./..."
  golangci-lint run ./...
else
  echo "[pre-commit] WARNING: golangci-lint not found — skipping lint"
  echo "             Install: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest"
fi

echo "[pre-commit] all checks passed"
